{
  "name": "lets-b-mad-linux-prereqs",
  "description": "Linux apt and pinned CLI tools for lets-b-mad E2E (shuru checkpoint recipe; binary stored locally by shuru CLI)",
  "bootstrap": "shuru-bootstrap-prereqs.sh",
  "create_command": "tests/e2e/create-shuru-checkpoint.sh",
  "run_command": "shuru run --from lets-b-mad-linux-prereqs",
  "packages": {
    "apt": [
      "git",
      "curl",
      "ca-certificates",
      "python3",
      "python3-dev",
      "python3-venv",
      "nodejs",
      "npm",
      "build-essential",
      "wget"
    ],
    "pinned": {
      "jq": "1.8.1",
      "yq": "4.53.2",
      "uv": "/usr/local/bin/uv"
    }
  },
  "marker_file": "/etc/lets-b-mad-e2e-prereqs-ready"
}
